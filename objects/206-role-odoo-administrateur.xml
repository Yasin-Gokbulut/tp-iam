<?xml version="1.0" encoding="UTF-8"?>
<role oid="e2000000-0000-0000-0000-000000000006"
      xmlns="http://midpoint.evolveum.com/xml/ns/public/common/common-3"
      xmlns:ri="http://midpoint.evolveum.com/xml/ns/public/resource/instance-3">
    <name>Odoo - Administrateur</name>
    <description>Administration complète d'Odoo (paramètres, droits d'accès). Rôle privilégié. Groupe(s) Odoo : base.group_system, base.group_erp_manager.</description>
    <!-- Archétype "Application role" (rôle technique lié à une application) -->
    <assignment>
        <targetRef oid="00000000-0000-0000-0000-000000000328" type="ArchetypeType"/>
    </assignment>
    <!-- Le droit : un compte Odoo portant le(s) groupe(s) ci-dessous -->
    <inducement>
        <construction>
            <resourceRef oid="e1000000-0000-0000-0000-000000000002" type="ResourceType"/>
            <kind>account</kind>
            <intent>default</intent>
            <attribute>
                <ref>ri:groups_id</ref>
                <outbound>
                    <strength>strong</strength>
                    <expression>
                        <value>4</value>  <!-- base.group_system -->
                        <value>2</value>  <!-- base.group_erp_manager -->
                    </expression>
                </outbound>
            </attribute>
        </construction>
    </inducement>
    <requestable>false</requestable>
</role>
